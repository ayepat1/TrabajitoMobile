<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="#F8FAFC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center">

        <!-- CONTENEDOR PRINCIPAL -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@android:color/white"
            android:padding="20dp"
            android:elevation="6dp"
            android:divider="@null"
            android:showDividers="none"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:gravity="center"
            android:clipToOutline="true"
            android:backgroundTint="#FFFFFF"
            android:layout_gravity="center"
            android:weightSum="2"
            android:layout_margin="5dp">

            <!-- COLUMNA IZQUIERDA (POSTULACIÓN) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="10dp"
                android:background="#FFFFFF"
                android:divider="@null"
                android:showDividers="none"
                android:layout_marginEnd="8dp"
                android:gravity="center">

                <TextView
                    android:id="@+id/tituloPostulacion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Detalles de la Postulación"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#02283A"
                    android:layout_marginBottom="10dp"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/budget"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Presupuesto:"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/submittedAt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fecha de postulación:"
                    android:textSize="13sp"
                    android:textColor="#637381"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/requireVisit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="¿Requiere visita?:"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:id="@+id/labelComentarios"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Comentarios:"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginTop="5dp" />

                <TextView
                    android:id="@+id/description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="10dp"
                    android:layout_marginTop="5dp"
                    android:background="#F2F5F7"
                    android:textColor="#333333"
                    android:gravity="start" />

                <Button
                    android:id="@+id/selectWorkerButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Seleccionar Worker"
                    android:textColor="@android:color/white"
                    android:backgroundTint="#00b4d8"
                    android:layout_marginTop="15dp"
                    android:padding="10dp" />

            </LinearLayout>


            <!-- COLUMNA DERECHA (WORKER PROFILE) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="10dp"
                android:layout_marginStart="8dp">

                <ImageView
                    android:id="@+id/workerImage"
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_person"
                    android:background="@drawable/circle_mask"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:id="@+id/workerName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nombre del Worker"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="5dp" />

                <TextView
                    android:id="@+id/workerRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⭐ 4.5"
                    android:textColor="#F3C218"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/workerDescription"
                    android:layout_width="250dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="#34495E"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/workerSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#3742fa"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:id="@+id/workerLocations"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Locaciones:"
                    android:layout_marginBottom="4dp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/workerLocationsValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#333333"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/workerDays"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Días:"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/workerDaysValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/workerHours"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Horarios:"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/workerHoursValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
