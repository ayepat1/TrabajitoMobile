<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_marginBottom="16dp"
    android:backgroundTint="#F4FBFD"
    android:elevation="3dp"
    android:background="@drawable/card">

    <!-- Título -->
    <TextView
        android:id="@+id/txtTituloSolicitud"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Título de la solicitud"
        android:textColor="#02283A"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp"/>

    <!-- Descripción -->
    <TextView
        android:id="@+id/txtDescripcion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Descripción del trabajo solicitado."
        android:textColor="#555555"
        android:layout_marginBottom="10dp"/>

    <!-- Datos (fecha, tipo, urgencia, ubicación) -->
    <LinearLayout
        android:id="@+id/contenedorDatos"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/txtFecha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fecha: "
            android:textColor="#02283A"
            android:textSize="14sp"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/txtTipoTrabajo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tipo de trabajo: "
            android:textColor="#02283A"
            android:textSize="14sp"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/txtUrgencia"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Urgencia: "
            android:textColor="#02283A"
            android:textSize="14sp"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/txtUbicacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ubicación: "
            android:textColor="#02283A"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>
    </LinearLayout>

    <!-- Botones -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="10dp"
        android:layout_gravity="end"
        android:paddingTop="6dp"
        android:paddingBottom="4dp">

        <Button
            android:id="@+id/btnVer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ver"
            android:background="#43A1FF"
            android:textColor="#FFFFFF"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:layout_marginRight="8dp"/>

        <Button
            android:id="@+id/btnCancelar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancelar"
            android:background="#FF5757"
            android:textColor="#FFFFFF"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"/>
    </LinearLayout>

</LinearLayout>
