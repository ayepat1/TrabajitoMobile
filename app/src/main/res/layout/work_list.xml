<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- TITULO -->
        <TextView
            android:id="@+id/txtTitleWorks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Trabajos disponibles"
            android:textSize="22sp"
            android:gravity="center"
            android:textStyle="bold"
            android:paddingBottom="16dp"
            android:textColor="#02283A" />

        <!-- MENSAJE SIN RESULTADOS -->
        <TextView
            android:id="@+id/txtEmptyMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No hay solicitudes correspondientes a tu rubro."
            android:textSize="15sp"
            android:textColor="#777"
            android:gravity="center"
            android:padding="20dp"
            android:visibility="gone" />

        <!-- LISTA DE TRABAJOS (DINÁMICA) -->
        <LinearLayout
            android:id="@+id/layoutWorks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>

</ScrollView>
