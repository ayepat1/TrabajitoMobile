<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ===============================
             SECCION DEL SERVICIO (ARRIBA)
             =============================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/card"
            android:layout_marginBottom="20dp">

            <TextView
                android:id="@+id/serviceTitle"
                android:text="Título del servicio"
                android:textStyle="bold"
                android:textSize="22sp"
                android:layout_marginBottom="10dp"
                android:layout_height="wrap_content"
                android:layout_width="match_parent"/>

            <TextView
                android:text="Fecha:"
                android:textStyle="bold"
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:layout_gravity="center"/>

            <TextView
                android:id="@+id/serviceDate"
                android:text="10/06/2024"
                android:layout_marginBottom="8dp"
                android:layout_height="wrap_content"
                android:layout_width="match_parent"/>

            <TextView
                android:text="Presupuesto:"
                android:textStyle="bold"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"/>

            <TextView
                android:id="@+id/serviceBudget"
                android:text="$4500"
                android:layout_marginBottom="8dp"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"/>

            <TextView
                android:text="Tipo:"
                android:textStyle="bold"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"/>

            <TextView
                android:id="@+id/serviceType"
                android:text="Limpieza"
                android:layout_marginBottom="8dp"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"/>

            <TextView
                android:text="Ubicación:"
                android:textStyle="bold"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"/>

            <TextView
                android:id="@+id/serviceLocation"
                android:text="CABA, Palermo"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"/>

        </LinearLayout>

        <!-- ===============================
             DOS CARDS ABAJO (SIDE BY SIDE)
             =============================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <!-- ===== Requester ===== -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:padding="16dp"
                android:orientation="vertical"
                android:background="@drawable/card"
                android:layout_marginRight="8dp">

                <ImageView
                    android:id="@+id/requesterPhoto"
                    android:layout_width="110dp"
                    android:layout_height="110dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_person"
                    android:scaleType="centerCrop"
                    android:background="@drawable/circle_mask"
                    android:padding="3dp"/>

                <TextView
                    android:id="@+id/requesterName"
                    android:text="Nombre Apellido"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:gravity="center"
                    android:layout_marginTop="8dp"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"/>

                <TextView
                    android:text="Solicitante"
                    android:textColor="#666"
                    android:gravity="center"
                    android:layout_marginBottom="8dp"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"/>

                <TextView
                    android:text="Datos de contacto"
                    android:textStyle="bold"
                    android:textColor="#3F51B5"
                    android:layout_marginTop="8dp"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"/>

                <TextView
                    android:id="@+id/requesterEmail"
                    android:text="Email: ejemplo@mail.com"
                    android:layout_marginTop="4dp"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"/>

                <TextView
                    android:id="@+id/requesterPhone"
                    android:text="Teléfono: 12345678"
                    android:layout_marginTop="2dp"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"/>

                <Button
                    android:id="@+id/btnRequesterConfirm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Confirmar acuerdo"
                    android:background="@color/celeste"
                    android:textColor="@android:color/white"
                    android:layout_marginTop="16dp"/>
            </LinearLayout>

            <!-- ===== Worker ===== -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:padding="16dp"
                android:orientation="vertical"
                android:background="@drawable/card"
                android:layout_marginLeft="8dp">

                <ImageView
                    android:id="@+id/workerPhoto"
                    android:layout_width="110dp"
                    android:layout_height="110dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_person"
                    android:scaleType="centerCrop"
                    android:background="@drawable/circle_mask"
                    android:padding="3dp"/>

                <TextView
                    android:id="@+id/workerName"
                    android:text="Nombre Worker"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:gravity="center"
                    android:layout_marginTop="8dp"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"/>

                <TextView
                    android:text="Worker"
                    android:textColor="#666"
                    android:gravity="center"
                    android:layout_marginBottom="8dp"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"/>

                <TextView
                    android:id="@+id/workerRating"
                    android:text="⭐ 4.8"
                    android:gravity="center"
                    android:textColor="#FFC107"
                    android:layout_marginBottom="12dp"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"/>

                <TextView
                    android:text="Datos del trabajador"
                    android:textStyle="bold"
                    android:textColor="#3F51B5"
                    android:layout_marginBottom="6dp"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"/>

                <TextView
                    android:id="@+id/workerLocations"
                    android:text="Locaciones: Palermo, Recoleta"
                    android:layout_marginBottom="4dp"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"/>

                <TextView
                    android:id="@+id/workerDays"
                    android:text="Días: Lun - Vie"
                    android:layout_marginBottom="4dp"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"/>

                <TextView
                    android:id="@+id/workerHours"
                    android:text="Horarios: 10 a 18hs"
                    android:layout_marginBottom="4dp"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"/>

                <Button
                    android:id="@+id/btnWorkerConfirm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Confirmar acuerdo"
                    android:background="@color/celeste"
                    android:textColor="@android:color/white"
                    android:layout_marginTop="16dp"/>
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</ScrollView>
