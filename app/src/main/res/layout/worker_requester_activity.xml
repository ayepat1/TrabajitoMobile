<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 📍 Sección Solicitante -->
            <LinearLayout
                android:id="@+id/requesterSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card"
                android:padding="16dp"
                android:elevation="4dp"
                android:layout_marginBottom="20dp">

                <ImageView
                    android:id="@+id/imgRequester"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_gravity="center"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_person"
                    android:background="@drawable/card" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Datos de contacto"
                    android:textColor="@color/azul_oscuro"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvRequesterName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Juan Pérez"
                    android:textAlignment="center"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:layout_marginTop="8dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Solicitante de servicios"
                    android:textAlignment="center"
                    android:textColor="@color/g1"/>

                <TextView
                    android:text="Datos de contacto"
                    android:textStyle="bold"
                    android:textColor="@color/azul_oscuro"
                    android:layout_marginTop="8dp"
                    android:textSize="16sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:id="@+id/tvRequesterEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Email: juan@example.com"/>

                <TextView
                    android:id="@+id/tvRequesterPhone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Teléfono: 123456789"/>

                <Button
                    android:id="@+id/btnRequesterAgreement"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Confirmar acuerdo"
                    android:backgroundTint="@color/celeste"
                    android:textColor="@android:color/white"/>

            </LinearLayout>

            <!-- 📄 Sección Servicio -->
            <LinearLayout
                android:id="@+id/serviceSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card"
                android:padding="16dp"
                android:elevation="4dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:id="@+id/tvServiceTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Servicio de plomería"
                    android:textAlignment="center"
                    android:textStyle="bold"
                    android:textSize="20sp"
                    android:layout_marginBottom="10dp"/>

                <TextView
                    android:id="@+id/tvServiceDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fecha: 10/11/2025"/>

                <TextView
                    android:id="@+id/tvServiceBudget"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Presupuesto: $5000"/>

                <TextView
                    android:id="@+id/tvServiceType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tipo: Plomería"/>

                <TextView
                    android:id="@+id/tvServiceLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ubicación: Buenos Aires, Argentina"/>
            </LinearLayout>

            <!-- 👷 Sección Worker -->
            <LinearLayout
                android:id="@+id/workerSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card"
                android:padding="16dp"
                android:elevation="4dp"
                android:layout_marginBottom="30dp">

                <ImageView
                    android:id="@+id/imgWorker"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_gravity="center"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_person"
                    android:background="@drawable/card" />

                <TextView
                    android:id="@+id/tvWorkerName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Carlos López"
                    android:textAlignment="center"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:layout_marginTop="8dp"/>

                <TextView
                    android:text="Worker"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAlignment="center"
                    android:textColor="@color/g1"/>

                <TextView
                    android:id="@+id/tvWorkerRating"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="⭐ 4.8"
                    android:textAlignment="center"
                    android:textColor="@color/celeste"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvWorkerLocations"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Locaciones: CABA, GBA"/>

                <TextView
                    android:id="@+id/tvWorkerDays"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Días: Lunes a Viernes"/>

                <TextView
                    android:id="@+id/tvWorkerHours"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Horarios: 9:00 - 18:00"/>

                <Button
                    android:id="@+id/btnWorkerAgreement"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Confirmar acuerdo"
                    android:backgroundTint="@color/celeste"
                    android:textColor="@android:color/white"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
