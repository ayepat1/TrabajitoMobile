<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/card"
    android:layout_marginBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <TextView
            android:id="@+id/txtWorkTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Título"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#222" />

        <TextView
            android:id="@+id/txtUrgent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="URGENTE"
            android:padding="4dp"
            android:background="#C62828"
            android:textColor="#fff"
            android:textStyle="bold"
            android:visibility="gone"
            android:textSize="12sp"/>
    </LinearLayout>

    <TextView
        android:id="@+id/txtDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Fecha:"
        android:textColor="#555"
        android:textSize="14sp"/>

    <TextView
        android:id="@+id/txtAddress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Dirección:"
        android:textColor="#555"
        android:textSize="14sp"/>

    <TextView
        android:id="@+id/txtWorkType"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tipo de trabajo:"
        android:textColor="#555"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/txtDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:text="Descripción del trabajo..."
        android:textColor="#333"
        android:textSize="14sp"/>

    <TextView
        android:id="@+id/txtOwnPostulation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Esta es tu propia postulación"
        android:textColor="#444"
        android:textStyle="bold"
        android:paddingTop="10dp"
        android:visibility="gone" />

    <Button
        android:id="@+id/btnVerServicio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ver servicio"
        android:textStyle="bold"
        android:padding="10dp"
        android:textColor="#FFFFFF"
        android:background="@color/azul_oscuro"
        android:layout_marginTop="14dp" />

</LinearLayout>
